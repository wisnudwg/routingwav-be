generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum KycType {
  INDIVIDUAL
  BUSINESS
}

enum KycStatus {
  IN_REVIEW
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum KycDocKind {
  KTP
  SELFIE
  NPWP
  NIB
  REP_KTP
  DEED
}

enum KycDocStatus {
  PENDING_UPLOAD
  UPLOADED
  REJECTED
}

model KycCase {
  /// Generated in code: it is part of the encryption context
  id          String    @id @db.Uuid
  accountId   String    @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type        KycType
  status      KycStatus

  // Not sensitive enough to encrypt: shown to the owner and used for contracts
  fullName    String?
  entityType  String?
  legalName   String?
  repName     String?

  // Identity numbers: AES-256-GCM with a per-case key
  dekWrapped  String
  nikEnc      String?
  npwpEnc     String?
  nibEnc      String?
  repNikEnc   String?
  // Keyed hashes for duplicate detection (the numbers themselves can't be recovered from them without the key)
  nikIdx      String?
  npwpIdx     String?
  nibIdx      String?
  /// Display masks like "•••• •••• •••• 0001"
  masked      Json

  provider            String
  externalRef         String?   @unique
  providerStartedAt   DateTime? @db.Timestamptz(3)
  userActionUrl       String?
  userActionExpiresAt DateTime? @db.Timestamptz(3)
  rejectionCode       String?

  submittedAt DateTime  @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime? @db.Timestamptz(3)
  /// Earliest date this case's data may be purged. Nothing is deleted automatically yet.
  retainUntil DateTime? @db.Timestamptz(3)

  documents KycDocument[]

  @@index([accountId, submittedAt])
  @@map("kyc_cases")
}

model KycDocument {
  id           String       @id @db.Uuid
  accountId    String       @db.Uuid
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  caseId       String?      @db.Uuid
  case         KycCase?     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  kind         KycDocKind
  status       KycDocStatus @default(PENDING_UPLOAD)
  /// Random: never derived from the user's file name
  objectKey    String       @unique
  originalName String
  contentType  String
  size         Int?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  uploadedAt   DateTime?    @db.Timestamptz(3)

  @@index([accountId, status])
  @@index([caseId])
  @@map("kyc_documents")
}

model KycProviderEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  eventId    String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("kyc_provider_events")
}

enum UserType {
  ROOT
  IAM
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProfileKind {
  TALENT
  CLIENT
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  VERIFY_NOTIFICATION_EMAIL
}

model Account {
  id        String   @id @default(uuid()) @db.Uuid
  alias     String   @unique
  phone     String?
  phoneCountry String? @db.Char(2)
  country   String?  @db.Char(2)
  address   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users    User[]
  profiles Profile[]
  kycCases     KycCase[]
  kycDocuments KycDocument[]

  @@map("accounts")
}

/// Owner (ROOT) and team members (IAM) share a table; CHECK constraints in the migration enforce the shapes.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  type               UserType
  /// Null only for a ROOT user who signed up with Google and hasn't completed their profile yet
  accountId          String?    @db.Uuid
  account            Account?   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  email              String?    @unique
  emailVerifiedAt    DateTime?  @db.Timestamptz(3)
  username           String?
  name               String?
  passwordHash       String?
  googleSub          String?    @unique
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  permissions        String[]   @default([])
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?  @db.Timestamptz(3)
  lastSignInAt       DateTime?  @db.Timestamptz(3)
  notificationEmail           String?
  notificationEmailVerifiedAt DateTime? @db.Timestamptz(3)
  termsAcceptedAt    DateTime?  @db.Timestamptz(3)
  tempPasswordExpiresAt       DateTime? @db.Timestamptz(3)
  termsVersion       String?
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  sessions Session[]
  tokens   AuthToken[]

  @@unique([accountId, username])
  @@index([accountId])
  @@map("users")
}

model Profile {
  id          String      @id @default(uuid()) @db.Uuid
  accountId   String      @db.Uuid
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        ProfileKind
  roles       String[]
  otherRole   String?
  instruments String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([accountId, kind])
  @@map("profiles")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie value. The raw token is never stored.
  tokenHash  String   @unique
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  ip         String?
  userAgent  String?
  elevatedUntil DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  target    String?
  /// SHA-256 of the emailed token
  tokenHash String       @unique
  expiresAt DateTime     @db.Timestamptz(3)
  usedAt    DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Append-only (a trigger in the migration blocks UPDATE/DELETE). No FKs on purpose: logs must outlive accounts.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)
  accountId  String?  @db.Uuid
  actorId    String?  @db.Uuid
  actorLabel String
  action     String
  detail     String?
  ip         String?

  @@index([accountId, at])
  @@map("audit_events")
}